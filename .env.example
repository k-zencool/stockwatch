# Copy to .env on the server and replace every value. .env is gitignored — never commit it.
# Generate strong values, e.g.:  openssl rand -base64 24

# Domain the app is served on (used by Caddy to request the HTTPS certificate).
APP_DOMAIN=your-name.duckdns.org
# Email Let's Encrypt uses for expiry warnings.
ACME_EMAIL=you@example.com

DB_NAME=stock_tracker
DB_USER=appuser
DB_PASS=CHANGE_ME_app_password
DB_ROOT_PASSWORD=CHANGE_ME_root_password
